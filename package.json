{
  "name": "opencode-mcp-bridge",
  "version": "0.2.0",
  "description": "Execution-only MCP toolbox using the actual pinned OpenCode tool implementations, without LLM delegation",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "opencode-mcp-bridge": "dist/index.js" },
  "engines": { "node": ">=22" },
  "files": ["dist", "runtime", "scripts", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup:native": "npm run build && node scripts/setup-native.mjs",
    "typecheck:native": "node scripts/typecheck-native.mjs",
    "start": "node dist/index.js --stdio",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": ["mcp", "opencode", "execution-toolbox", "model-context-protocol"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
