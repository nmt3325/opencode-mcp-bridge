{
  "name": "opencode-mcp-bridge",
  "version": "0.3.0",
  "description": "OpenCode standard-chat Notion AI provider with an automatically managed execution MCP toolbox",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-mcp-bridge": "dist/index.js"
  },
  "engines": {
    "node": ">=22",
    "opencode": "1.18.29"
  },
  "files": [
    "dist",
    "runtime",
    "scripts",
    "README.md",
    "LICENSE",
    "docs",
    "src/vendor/notion-ai/PROVENANCE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup:native": "node scripts/setup-native.mjs",
    "typecheck:native": "node scripts/typecheck-native.mjs",
    "start": "node dist/index.js --stdio",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "prepack": "npm run build",
    "test:opencode": "npm run build && node scripts/test-opencode-plugin.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "keywords": [
    "mcp",
    "opencode",
    "execution-toolbox",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "@opencode-ai/plugin": "1.18.29"
  },
  "exports": {
    ".": "./dist/plugin.js",
    "./server": "./dist/plugin.js",
    "./toolbox": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "optionalDependencies": {
    "@oven/bun-linux-x64-baseline": "1.3.14",
    "@oven/bun-linux-aarch64": "1.3.14",
    "@oven/bun-linux-x64-musl-baseline": "1.3.14",
    "@oven/bun-linux-aarch64-musl": "1.3.14",
    "@oven/bun-darwin-x64-baseline": "1.3.14",
    "@oven/bun-darwin-aarch64": "1.3.14",
    "@oven/bun-windows-x64-baseline": "1.3.14",
    "@oven/bun-windows-aarch64": "1.3.14"
  }
}
